package layout

import "github.com/antonisgkamitsios/verese/static"
import "github.com/antonisgkamitsios/verese/internal/htmx"

templ Base(title string) {
	if htmx.ContextGetHtmxRequest(ctx) {
		<title>{ title }</title>
		<head>
			<link data-track="reload" href={ static.FilePath("style.css") } rel="stylesheet"/>
			<script data-track="reload" src={ static.FilePath("index.js") } type="text/javascript"></script>
		</head>
		<div id="contents">
			{ children... }
		</div>
	} else {
		<!DOCTYPE html>
		<html lang="en">
			<head>
				<meta charset="UTF-8"/>
				<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
				<link data-track="reload" href={ static.FilePath("style.css") } rel="stylesheet"/>
				<script data-track="reload" src={ static.FilePath("index.js") } type="text/javascript"></script>
				<script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.1" integrity="sha384-Qp9rdC8H7EqOoX+nR0P3RPG2Noji+qdwJlGpfzwQJsfOpp3sGwIdSP9xO3+UlEhn" crossorigin="anonymous"></script>
				<title>{ title }</title>
			</head>
			<body>
				@Header()
				<main class="grow">
					<div id="contents">
						{ children... }
					</div>
				</main>
			</body>
		</html>
	}
}
